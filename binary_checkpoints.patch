 static inline uint32_t FNV1a16(const std::string &s)
 {
 	uint32_t h = 2166136261u;
 	for (unsigned char c : s)
 	{
 		h ^= c;
 		h *= 16777619u;
 	}
 	return h & 0xFFFFu;
 }
 
 static inline std::string Norm(std::string v)
 {
 	for (auto &ch : v)
 	{
 		if (ch == '\\')
 			ch = '/';
 		ch = (char)std::tolower((unsigned char)ch);
 	}
 	return v;
 }
